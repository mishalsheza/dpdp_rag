# Copy to .env and fill in locally. Never commit .env.
# Qdrant Cloud (leave empty to use the local docker-compose instance at localhost:6333).
QDRANT_URL=
QDRANT_API_KEY=
# Groq API key for answers and the eval judge (free tier: console.groq.com/keys).
GROQ_API_KEY=
# Optional: extra config overrides from configs/, comma-separated (e.g. loadtest.yaml).
DPDP_CONFIG_OVERRIDES=
# Langfuse tracing (leave empty to disable). LANGFUSE_HOST defaults to Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional: overrides the git SHA reported by GET /version (e.g. set in CI/containers).
GIT_SHA=
