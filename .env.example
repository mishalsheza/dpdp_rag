# Copy to .env and fill in locally. Never commit .env.
# Qdrant Cloud (leave empty to use the local docker-compose instance at localhost:6333).
QDRANT_URL=
QDRANT_API_KEY=
# Anthropic API key for answer generation (or use an `ant auth login` profile).
ANTHROPIC_API_KEY=
# Langfuse tracing (leave empty to disable). LANGFUSE_HOST defaults to Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional: overrides the git SHA reported by GET /version (e.g. set in CI/containers).
GIT_SHA=
